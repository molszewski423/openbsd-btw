command term "urxvt -e fish"
fontname "JetBrainsMono Nerd Font Propo:pixelsize=14"
command neovim "urxvt -e nvim"
command htop "urxvt -e htop"
color activeborder "#bb9af7"
color menubg "#1a1b26"
color menufg "#c0caf5"
color font "#c0caf5"
color selfont "#bb9af7"
# --- auto GUI app menu (managed by sync-cwm-menu, do not edit below) ---
command libreoffice-26-2-calc "libreoffice26.2 --calc"
command libreoffice-26-2-draw "libreoffice26.2 --draw"
command firefox-web-browser "firefox"
command libreoffice-26-2-impress "libreoffice26.2 --impress"
command libreoffice-26-2-math "libreoffice26.2 --math"
command panel "xfce4-panel --preferences"
command rofi-theme-selector "rofi-theme-selector"
command rofi "rofi -show"
command libreoffice-26-2 "libreoffice26.2"
command bulk-rename "thunar --bulk-rename"
command thunar-preferences "thunar-settings"
command thunar-file-manager "thunar"
command libreoffice-26-2-writer "libreoffice26.2 --writer"
command about-xfce "xfce4-about"
# --- end auto GUI app menu ---
