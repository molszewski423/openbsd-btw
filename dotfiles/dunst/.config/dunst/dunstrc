[global]
    font = JetBrainsMono Nerd Font 10
    frame_width = 2
    frame_color = "#414868"
    corner_radius = 6
    background = "#1a1b26"
    foreground = "#c0caf5"
    width = 300
    height = 100
    origin = top-right
    offset = 10x30
    padding = 12
    horizontal_padding = 12
    separator_color = "#414868"

[urgency_low]
    background = "#1a1b26"
    foreground = "#565f89"
    frame_color = "#414868"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#bb9af7"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
